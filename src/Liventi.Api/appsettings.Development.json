{
  "ConnectionStrings": {
    "Database": "Host=liventi-db;Port=5432;Database=liventi;Username=postgres;Password=postgres;"
  },
  "Serilog": {
    "Using": ["Serilog.Sinks.Console", "Serilog.Sinks.Seq"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "Seq",
        "Args": { "serverUrl": "http://liventi-seq:5341" }
      }
    ],
    "Enrich": ["FromLogContext", "WithMachineName", "WithThreadId"]
  },
  "Authentication": {
    "Audience": "account",
    "ValidIssuer": "http://liventi-idp:8080/realms/liventi",
    "MetadataUrl": "http://liventi-idp:8080/realms/liventi/.well-known/openid-configuration",
    "RequireHttpsMetadata": false
  },
  "Keycloak": {
    "BaseUrl": "http://liventi-idp:8080",
    "AdminUrl": "http://liventi-idp:8080/admin/realms/liventi/",
    "TokenUrl": "http://liventi-idp:8080/realms/liventi/protocol/openid-connect/token",
    "AdminClientId": "liventi-admin-client",
    "AdminClientSecret": "UZDmbNxWmV4TlpaCRcju6pMRsyuV3er1",
    "AuthClientId": "liventi-auth-client",
    "AuthClientSecret": "3E3yvXaYppoYBF3Ir6DgtEzADKKzSurZ"
  }
}
